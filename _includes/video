{%- comment -%}
  Kept for posts written with Minimal Mistakes' `{% include video id="…" provider="…" %}`.
{%- endcomment -%}
{%- case include.provider -%}
  {%- when "youtube" -%}
    {%- assign video_src = "https://www.youtube-nocookie.com/embed/" | append: include.id -%}
  {%- when "vimeo" -%}
    {%- assign video_src = "https://player.vimeo.com/video/" | append: include.id | append: "?dnt=true" -%}
{%- endcase -%}
{%- if video_src -%}
<div class="wn-video">
  <iframe
    src="{{ video_src }}"
    title="{{ include.title | default: '동영상' | escape }}"
    loading="lazy"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>
{%- endif -%}
